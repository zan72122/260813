{
  "name": "eiffel-elevator-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ななめなのに水平！ エッフェル塔エレベーター — a children's mobile web game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "three": "0.185.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
