{
  "name": "toro-kakukaku-niji-bismuth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "とろっ！カクカク！にじビスマス工房 - 4歳児向けビスマス結晶づくりモバイルWebゲーム",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "lint": "eslint src tests *.js",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test": "npm run lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "vite": "^5.4.10"
  }
}
