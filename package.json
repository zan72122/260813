{
  "name": "kona-factory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "White powder gummy factory - a discovery game for 4 year olds (iPhone/iPad web)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint src tests",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "E2E_FAST=1 playwright test tests/e2e/smoke.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "eslint": "^9.16.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "three": "^0.171.0"
  }
}
