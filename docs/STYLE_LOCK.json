{
  "$comment": "Waterfall Hair Garden — machine-readable style lock. Code imports this file directly (src/*). Do not change values without reading docs/DESIGN_CONSTITUTION.md. Units: meters, seconds, degrees.",
  "identity": {
    "title": "Waterfall Hair Garden",
    "artDirection": "Twilight Water Garden — 夕暮れの水の庭",
    "oneLine": "髪の流れを編み、庭を育てるように一輪の花を咲かせる、触れる短編アニメーション"
  },
  "palette": {
    "skyTop": "#1b2947",
    "skyMid": "#28436b",
    "skyLow": "#456f82",
    "skyGlow": "#7fb9b0",
    "groundMist": "#152238",
    "hairBase": "#b06f3e",
    "hairShadow": "#7d4a33",
    "hairSheen": "#ffe4c9",
    "hairRim": "#9fd8d0",
    "skin": "#f2d8c4",
    "dress": "#3a2f4d",
    "dressTrim": "#c9a86a",
    "gemCore": "#7fe0d0",
    "gemDeep": "#3e7f8e",
    "gemSpark": "#fff6e0",
    "moteWarm": "#ffd9a0",
    "moteCool": "#a8e4d8",
    "uiLine": "#d8c49a",
    "uiInk": "#eae4d4",
    "hintGlow": "#ffedc2"
  },
  "valueHierarchy": {
    "$comment": "Relative luminance ordering that must never invert.",
    "order": ["hairSheen > hairBase > skyGlow > skyLow > skyMid > dress > skyTop > groundMist"],
    "hairVsBackgroundMinContrast": 2.2
  },
  "rendering": {
    "pixelRatioMax": 2,
